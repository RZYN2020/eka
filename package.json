{
  "name": "eka-site",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-resume-pdf.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "sync:neodb": "node --env-file-if-exists=.env scripts/sync-neodb.mjs",
    "migrate": "node scripts/migrate-content.mjs && node scripts/migrate-custom-pages.mjs",
    "check": "astro check",
    "check:map": "node scripts/verify-map-runtime.mjs",
    "verify": "node scripts/verify-neodb.mjs && node scripts/verify-travel-time.mjs && node scripts/verify-travel-journey.mjs && node scripts/verify-build.mjs && node scripts/verify-content-styles.mjs && node scripts/verify-terminal.mjs",
    "verify:terminal": "node scripts/verify-terminal.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "d3": "^7.9.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.18.1",
    "leaflet": "^1.9.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3",
    "smol-toml": "^1.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/leaflet": "^1.9.21",
    "puppeteer": "^25.3.0",
    "typescript": "^6.0.3"
  }
}
