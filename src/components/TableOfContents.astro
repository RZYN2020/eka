---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{items.length >= 3 && (
	<>
		<details class="article-toc" open>
			<summary>Contents</summary>
			<nav aria-label="文章目录">
				{items.map((heading) => (
					<a href={`#${heading.slug}`} data-depth={heading.depth}>
						{heading.text}
					</a>
				))}
			</nav>
		</details>

		<details class="article-toc-mobile">
			<summary>Contents</summary>
			<nav aria-label="文章目录">
				{items.map((heading) => (
					<a href={`#${heading.slug}`} data-depth={heading.depth}>
						{heading.text}
					</a>
				))}
			</nav>
		</details>

		<script>
			const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.article-toc nav a')];
			const sections = tocLinks
				.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
				.filter((section): section is HTMLElement => Boolean(section));

			const setCurrent = () => {
				const current = [...sections]
					.reverse()
					.find((section) => section.getBoundingClientRect().top <= 120) ?? sections[0];
				tocLinks.forEach((link) => {
					if (decodeURIComponent(link.hash.slice(1)) === current?.id) link.setAttribute('aria-current', 'location');
					else link.removeAttribute('aria-current');
				});
			};

			let scheduled = false;
			document.addEventListener('scroll', () => {
				if (scheduled) return;
				scheduled = true;
				requestAnimationFrame(() => {
					setCurrent();
					scheduled = false;
				});
			}, { passive: true });
			setCurrent();
		</script>
	</>
)}
