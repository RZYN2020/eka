---
import type { NoteEntry } from '../lib/content';
import { noteSlug, noteSourceLabel } from '../lib/content';

interface Props {
	entries: NoteEntry[];
}

const { entries } = Astro.props;
---

<div class="note-list">
	{entries.map((entry) => (
		<article class="note-row">
			<span>{noteSourceLabel[entry.data.source]}</span>
			<h3><a href={`/notes/${noteSlug(entry.id)}/`}>{entry.data.title}</a></h3>
		</article>
	))}
</div>
