---
const repo = import.meta.env.PUBLIC_GISCUS_REPO;
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY;
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;
const enabled = Boolean(repo && repoId && category && categoryId);
---

{enabled && (
	<section class="comments" aria-labelledby="comments-title">
		<header>
			<p>Discussion</p>
			<h2 id="comments-title">评论</h2>
		</header>
		<div class="giscus"></div>
		<script
			is:inline
			src="https://giscus.app/client.js"
			data-repo={repo}
			data-repo-id={repoId}
			data-category={category}
			data-category-id={categoryId}
			data-mapping="pathname"
			data-strict="1"
			data-reactions-enabled="1"
			data-emit-metadata="0"
			data-input-position="top"
			data-theme="preferred_color_scheme"
			data-lang="zh-CN"
			data-loading="lazy"
			crossorigin="anonymous"
			async
		></script>
		<script is:inline>
			const giscusThemes = {
				light: 'light',
				sepia: 'light_protanopia',
				dark: 'dark',
				graphite: 'dark_dimmed',
			};

			const updateGiscusTheme = (themeName) => {
				const theme = giscusThemes[themeName] ?? 'preferred_color_scheme';
				document.querySelector('.giscus-frame')?.contentWindow?.postMessage({
					giscus: { setConfig: { theme } },
				}, 'https://giscus.app');
			};

			window.addEventListener('eka-theme-change', (event) => updateGiscusTheme(event.detail?.theme));
			window.addEventListener('load', () => updateGiscusTheme(document.documentElement.dataset.theme));
		</script>
	</section>
)}
