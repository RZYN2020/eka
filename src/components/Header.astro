---
const pathname = Astro.url.pathname;
const nav = [
	{ href: '/writing/', label: 'Writing' },
	{ href: '/notes/', label: 'Notes' },
	{ href: '/about/', label: 'About' },
];
---

<header class="site-header">
	<a class="brand" href="/" aria-label="Eka 首页">
		<span>Eka</span>
		<span class="brand-mark">赵勇臻</span>
	</a>
	<nav class="main-nav" aria-label="主导航">
		{nav.map((item) => (
			<a href={item.href} aria-current={pathname.startsWith(item.href) ? 'page' : undefined}>
				{item.label}
			</a>
		))}
		<a class="search-nav" href="/search/" aria-current={pathname.startsWith('/search/') ? 'page' : undefined}>Search</a>
	</nav>
</header>
