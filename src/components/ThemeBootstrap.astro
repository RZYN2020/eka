---
import {
	themeColors,
	themePreferences,
} from '../config/theme';
---

<meta name="theme-color" content={themeColors.light} />
<script is:inline define:vars={{ themeColors, themePreferences }}>
	(() => {
		const storageKey = 'eka-theme';
		const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');

		const isPreference = (value) => typeof value === 'string' && themePreferences.includes(value);
		const readPreference = () => {
			try {
				const value = window.localStorage.getItem(storageKey);
				return isPreference(value) ? value : 'auto';
			} catch {
				return 'auto';
			}
		};
		const resolveTheme = (preference) => (
			preference === 'auto'
				? systemTheme.matches ? 'dark' : 'light'
				: preference
		);
		const apply = (value, persist = true) => {
			const preference = isPreference(value) ? value : 'auto';
			const theme = resolveTheme(preference);
			document.documentElement.dataset.themePreference = preference;
			document.documentElement.dataset.theme = theme;
			document.querySelector('meta[name="theme-color"]')
				?.setAttribute('content', themeColors[theme] ?? themeColors.light);

			if (persist) {
				try {
					window.localStorage.setItem(storageKey, preference);
				} catch {
					// A blocked storage implementation must not prevent theme changes.
				}
			}

			window.dispatchEvent(new CustomEvent('eka-theme-change', {
				detail: { theme, preference },
			}));
			return { theme, preference };
		};

		window.ekaTheme = { apply, readPreference };
		apply(readPreference(), false);
		systemTheme.addEventListener('change', () => {
			if (document.documentElement.dataset.themePreference === 'auto') apply('auto', false);
		});
	})();
</script>
