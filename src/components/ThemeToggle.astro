---
import {
	themeNames,
	themePreferences,
} from '../config/theme';
---

<details class="theme-picker">
	<summary class="theme-toggle" aria-label="选择主题">
		<span>Auto</span>
	</summary>
	<div class="theme-menu" role="group" aria-label="网站主题">
		{themePreferences.map((preference) => (
			<button
				type="button"
				data-theme-value={preference}
				style={preference === 'auto' ? '--theme-swatch: linear-gradient(135deg, #fbfbfa 50%, #1e1e1e 50%)' : undefined}
			>
				<i aria-hidden="true"></i>{themeNames[preference]}
			</button>
		))}
	</div>
</details>

<script is:inline define:vars={{ themeNames }}>
	const picker = document.querySelector('.theme-picker');
	const label = picker?.querySelector('.theme-toggle span');
	const buttons = [...document.querySelectorAll('[data-theme-value]')];
	function updateLabel() {
		const preference = document.documentElement.dataset.themePreference ?? 'auto';
		if (label) label.textContent = themeNames[preference] ?? themeNames.auto;
		buttons.forEach((button) => {
			button.setAttribute('aria-pressed', String(button.dataset.themeValue === preference));
		});
	}

	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			const preference = button.dataset.themeValue ?? 'auto';
			window.ekaTheme?.apply(preference);
			picker?.removeAttribute('open');
		});
	});

	document.addEventListener('click', (event) => {
		if (picker?.open && !picker.contains(event.target)) picker.removeAttribute('open');
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') picker?.removeAttribute('open');
	});

	window.addEventListener('eka-theme-change', updateLabel);
	updateLabel();
</script>
