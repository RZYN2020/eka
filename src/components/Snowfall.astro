<style>
	.snowfall {
		position: fixed;
		z-index: 1;
		inset: 0;
		overflow: hidden;
		color: #3f78a2;
		pointer-events: none;
		-webkit-mask-image: linear-gradient(
			90deg,
			#000 0%,
			#000 10%,
			rgb(0 0 0 / 16%) 27%,
			rgb(0 0 0 / 12%) 73%,
			#000 90%,
			#000 100%
		);
		mask-image: linear-gradient(
			90deg,
			#000 0%,
			#000 10%,
			rgb(0 0 0 / 16%) 27%,
			rgb(0 0 0 / 12%) 73%,
			#000 90%,
			#000 100%
		);
	}

	.snowfall span {
		position: absolute;
		top: -10vh;
		left: var(--snow-x);
		width: 1em;
		height: 1em;
		font-family: Georgia, "Times New Roman", serif;
		font-size: calc(0.5rem + var(--snow-size) * 2);
		line-height: 1;
		filter: blur(var(--snow-blur));
		opacity: calc(var(--snow-opacity) + 0.18);
		transform: translate3d(0, -12vh, 0);
		animation: snow-fall var(--snow-duration) linear var(--snow-delay) infinite;
		will-change: transform;
	}

	.snowfall span::before {
		content: "❄";
	}

	@keyframes snow-fall {
		to {
			transform: translate3d(var(--snow-drift), 122vh, 0) rotate(240deg);
		}
	}

	:global(:root[data-theme="dark"]) .snowfall {
		color: #eef6fb;
	}

	@media (max-width: 720px) {
		.snowfall {
			opacity: 0.7;
			-webkit-mask-image: none;
			mask-image: none;
		}

		.snowfall span:nth-child(n + 17) {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.snowfall {
			display: none;
		}
	}
</style>
