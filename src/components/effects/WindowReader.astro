---
interface Props {
	placement?: 'media' | 'inline';
}

const { placement = 'media' } = Astro.props;

const frames = [
	{ name: 'rest', src: '/images/nagato-reader-frame-1.webp' },
	{ name: 'turn', src: '/images/nagato-reader-frame-2.webp' },
	{ name: 'settle', src: '/images/nagato-reader-frame-3.webp' },
] as const;
---

<div
	class:list={['window-reader', `window-reader--${placement}`]}
	data-reader-placement={placement}
	aria-hidden="true"
>
	{
		frames.map(({ name, src }, index) => (
			<img
				class:list={['window-reader__frame', `window-reader__frame--${name}`]}
				src={src}
				width="440"
				height="587"
				alt=""
				decoding="async"
				loading={placement === 'media' ? 'eager' : 'lazy'}
				fetchpriority={index === 0 && placement === 'media' ? 'high' : 'auto'}
			/>
		))
	}
</div>

<style>
	.window-reader {
		--reader-cycle: 10s;
		--reader-opacity: 0.74;
		position: relative;
		z-index: 0;
		width: clamp(11rem, 15vw, 13.5rem);
		aspect-ratio: 440 / 587;
		contain: layout paint;
		pointer-events: none;
		user-select: none;
	}

	.window-reader--media {
		position: fixed;
		right: clamp(0.875rem, calc(25vw - 19.125rem), 4rem);
		bottom: 1rem;
	}

	.window-reader--inline {
		width: clamp(10.5rem, 15vw, 12rem);
		margin-inline: auto;
	}

	.window-reader__frame {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		opacity: 0;
		filter: brightness(0) saturate(100%);
	}

	.window-reader--media .window-reader__frame {
		transform: translateX(18%);
	}

	.window-reader__frame--rest {
		animation: reader-rest var(--reader-cycle) steps(1, end) infinite;
	}

	.window-reader__frame--turn {
		animation: reader-turn var(--reader-cycle) steps(1, end) infinite;
	}

	.window-reader__frame--settle {
		animation: reader-settle var(--reader-cycle) steps(1, end) infinite;
	}

	@keyframes reader-rest {
		0%,
		68%,
		91%,
		100% {
			opacity: var(--reader-opacity);
		}
		69%,
		90% {
			opacity: 0;
		}
	}

	@keyframes reader-turn {
		0%,
		68%,
		79%,
		100% {
			opacity: 0;
		}
		69%,
		78% {
			opacity: var(--reader-opacity);
		}
	}

	@keyframes reader-settle {
		0%,
		78%,
		91%,
		100% {
			opacity: 0;
		}
		79%,
		90% {
			opacity: var(--reader-opacity);
		}
	}

	:global(:root[data-theme='dark']) .window-reader__frame {
		filter: brightness(0) saturate(100%) invert(1);
	}

	@media (max-width: 979px) {
		.window-reader--media {
			display: none;
		}

		.window-reader--inline {
			width: clamp(9rem, 46vw, 10.5rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.window-reader__frame {
			animation: none;
		}

		.window-reader__frame--rest {
			opacity: var(--reader-opacity);
		}
	}
</style>
