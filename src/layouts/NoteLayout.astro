---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/content';
import type { CollectionEntry } from 'astro:content';

interface Props {
	entry: CollectionEntry<'notes'>;
	headings: { depth: number; slug: string; text: string }[];
}

const { entry, headings } = Astro.props;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout title={entry.data.title} description={entry.data.description || `${entry.data.topic} 学习笔记`} article>
	<article class="note-layout">
		<header class="article-header">
			<div class="eyebrow">{entry.data.topic}</div>
			<h1>{entry.data.title}</h1>
			{entry.data.description && <p class="article-deck">{entry.data.description}</p>}
			<div class="article-meta">
				<span>{entry.data.source === 'algorithm' ? 'Algorithm Archive' : 'Knowledge Archive'}</span>
				<span>{formatDate(entry.data.updatedAt ?? entry.data.publishedAt)}</span>
			</div>
		</header>
		<div class="article-shell">
			{toc.length > 0 && (
				<aside class="article-aside" aria-label="笔记目录">
					<strong>On this page</strong>
					<ul>
						{toc.map((heading) => (
							<li style={heading.depth === 3 ? 'padding-left:.8rem' : undefined}>
								<a href={`#${heading.slug}`}>{heading.text}</a>
							</li>
						))}
					</ul>
				</aside>
			)}
			<div class="prose prose-eka">
				<slot />
			</div>
		</div>
	</article>
</BaseLayout>
