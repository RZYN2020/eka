---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/content';
import type { CollectionEntry } from 'astro:content';

interface Props {
	entry: CollectionEntry<'notes'>;
	headings: { depth: number; slug: string; text: string }[];
}

const { entry } = Astro.props;
---

<BaseLayout title={entry.data.title} description={entry.data.description} article>
	<article>
		<header class="article-header">
			<h1>{entry.data.title}</h1>
			{entry.data.description && <p class="article-deck">{entry.data.description}</p>}
		</header>
		<div class="article-shell">
			<div class="prose prose-eka">
				<slot />
			</div>
		</div>
		{(entry.data.updatedAt || entry.data.publishedAt) && (
			<footer class="post-footer">
				{formatDate(entry.data.updatedAt ?? entry.data.publishedAt, 'sv-SE')}
			</footer>
		)}
	</article>
</BaseLayout>
