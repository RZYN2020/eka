---
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeBootstrap from '../components/ThemeBootstrap.astro';
import { site } from '../config/site';
import { renderTerminal } from '../lib/terminal';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	article?: boolean;
}

const {
	title = site.fullTitle,
	description = site.description,
	article = false,
} = Astro.props;
const effectiveDescription = description.trim() || site.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === site.fullTitle ? title : `${title} · ${site.title}`;
const terminalCard = renderTerminal(await getCollection('writing'));
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={effectiveDescription} />
		<ThemeBootstrap />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/webp" href="/favicon.webp" />
		<link rel="alternate" type="application/rss+xml" title="Eka" href="/rss.xml" />
		<meta property="og:type" content={article ? 'article' : 'website'} />
		<meta property="og:locale" content="zh_CN" />
		<meta property="og:site_name" content={site.title} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={effectiveDescription} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={effectiveDescription} />
		<title>{pageTitle}</title>
		{import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN && (
			<script
				is:inline
				defer
				src="https://static.cloudflareinsights.com/beacon.min.js"
				data-cf-beacon={JSON.stringify({
					token: import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN,
					spa: false,
				})}
			></script>
		)}
	</head>
	<body>
		<a class="skip-link" href="#main-content">跳到正文</a>
		<div class="shell">
			<Header />
			<main id="main-content">
				<slot />
			</main>
			<Footer />
		</div>
		<div class="developer-toast" role="status" aria-live="polite" aria-hidden="true">
			<span aria-hidden="true">&gt;_</span>
			Welcome, developer.
		</div>
		<script is:inline define:vars={{ terminalCard }}>
			const toast = document.querySelector('.developer-toast');
			let toastTimer;

			window.addEventListener('keydown', (event) => {
				if (event.key !== 'F12' || event.repeat) return;

				window.setTimeout(() => {
					console.log(
						'%cEka%c\n' + terminalCard,
						'font: 700 24px/1.5 monospace; color: #b45309;',
						'font: 13px/1.5 monospace; color: inherit;',
					);
				}, 200);

				if (!(toast instanceof HTMLElement)) return;
				toast.setAttribute('aria-hidden', 'false');
				window.clearTimeout(toastTimer);
				toastTimer = window.setTimeout(() => {
					toast.setAttribute('aria-hidden', 'true');
				}, 2200);
			});
		</script>
	</body>
</html>
