---
import BaseLayout from './BaseLayout.astro';
import CategoryPath from '../components/CategoryPath.astro';
import TagList from '../components/TagList.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ArticleImages from '../components/ArticleImages.astro';
import Comments from '../components/Comments.astro';
import ArticleNavigation from '../components/ArticleNavigation.astro';
import Snowfall from '../components/Snowfall.astro';
import LushanBackdrop from '../components/LushanBackdrop.astro';
import { formatDate, writingDescription, writingSlug } from '../lib/content';
import type { CollectionEntry } from 'astro:content';
import 'katex/dist/katex.min.css';

interface Props {
	entry: CollectionEntry<'writing'>;
	headings: { depth: number; slug: string; text: string }[];
	newer?: CollectionEntry<'writing'>;
	older?: CollectionEntry<'writing'>;
}

const { entry, headings, newer, older } = Astro.props;
const description = writingDescription(entry);
const hasSnowfall = writingSlug(entry.id) === 'memories-of-snow';
const hasLushanBackdrop = writingSlug(entry.id) === 'lushan';
---

<BaseLayout title={entry.data.title} description={description} article>
	{hasSnowfall && <Snowfall />}
	<article>
		<header class="article-header">
			<div class="article-kicker">
				<CategoryPath category={entry.data.category} subcategories={entry.data.subcategories} />
				{entry.data.publishedAt && (
					<span class="article-dates">
						<time datetime={entry.data.publishedAt.toISOString()}>{formatDate(entry.data.publishedAt, 'sv-SE')}</time>
						{entry.data.updatedAt && entry.data.updatedAt > entry.data.publishedAt && (
							<span>
								Updated <time datetime={entry.data.updatedAt.toISOString()}>{formatDate(entry.data.updatedAt, 'sv-SE')}</time>
							</span>
						)}
					</span>
				)}
			</div>
			<h1>{entry.data.title}</h1>
			{entry.data.description && <p class="article-deck">{entry.data.description}</p>}
			<TagList tags={entry.data.tags} />
		</header>
		<div class:list={['article-visual-boundary', { 'article-visual-boundary--lushan': hasLushanBackdrop }]}>
			{hasLushanBackdrop && <LushanBackdrop />}
			<div class="article-shell">
				{entry.data.toc && <TableOfContents headings={headings} />}
				<div class="prose prose-eka">
					<slot />
				</div>
				<ArticleImages />
			</div>
		</div>
		<ArticleNavigation newer={newer} older={older} />
		<Comments />
	</article>
</BaseLayout>
