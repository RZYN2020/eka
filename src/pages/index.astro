---
import { getCollection } from 'astro:content';
import NoteList from '../components/NoteList.astro';
import WritingList from '../components/WritingList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortNotes, sortWriting } from '../lib/content';

const writing = sortWriting((await getCollection('writing')).filter((entry) => !entry.data.draft));
const notes = sortNotes((await getCollection('notes')).filter((entry) => !entry.data.draft));
const recentNotes = [...Map.groupBy(notes, (entry) => entry.data.topic).values()]
	.map((entries) => entries[0])
	.slice(0, 8);
---

<BaseLayout>
	<section class="home-intro">
		<h1>Eka</h1>
	</section>

	<section class="home-section">
		<div class="section-rule">
			<h2>Writing</h2>
		</div>
		<WritingList entries={writing} limit={12} />
	</section>

	<section class="home-section">
		<div class="section-rule">
			<h2>Notes</h2>
		</div>
		<NoteList entries={recentNotes} />
	</section>
</BaseLayout>
