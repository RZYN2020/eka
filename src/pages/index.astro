---
import { getCollection } from 'astro:content';
import WritingList from '../components/WritingList.astro';
import { categories } from '../config/taxonomy';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categorySlug, sortWriting } from '../lib/content';

const entries = sortWriting((await getCollection('writing')).filter((entry) => !entry.data.draft));
const homeCategory = site.home.category;

if (homeCategory && !categories.some((category) => category.name === homeCategory)) {
	throw new Error(`Unknown homepage category "${homeCategory}".`);
}

const latestWriting = homeCategory
	? entries.filter((entry) => entry.data.category === homeCategory)
	: entries;
---

<BaseLayout>
	<section class="home-intro">
		<h1>Eka</h1>
		<p>{site.description}</p>
	</section>

	<section class="home-section">
		<div class="section-rule">
			<h2>Latest writing</h2>
			<a href="/writing/">All writing</a>
		</div>
		<WritingList entries={latestWriting} limit={5} showTags={false} />
	</section>

	<section class="home-section">
		<div class="section-rule">
			<h2>Browse by topic</h2>
			<span>{entries.length} entries</span>
		</div>
		<nav class="home-topics" aria-label="按主题浏览">
			{categories.map((category) => {
				const count = entries.filter((entry) => entry.data.category === category.name).length;
				if (count === 0) return null;
				return (
					<a href={`/categories/${categorySlug(category.name)}/`}>
						<span>{category.name}</span>
						<small>{String(count).padStart(2, '0')}</small>
					</a>
				);
			})}
		</nav>
	</section>
</BaseLayout>
