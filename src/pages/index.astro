---
import { getCollection } from 'astro:content';
import WritingList from '../components/WritingList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortWriting } from '../lib/content';

const writing = sortWriting((await getCollection('writing')).filter((entry) => !entry.data.draft));
---

<BaseLayout>
	<section class="home-intro">
		<h1>Eka</h1>
	</section>

	<section class="home-section">
		<div class="section-rule">
			<h2>Recent blogs</h2>
			<a href="/writing/">All writing</a>
		</div>
		<WritingList entries={writing} limit={20} showTags={false} />
	</section>
</BaseLayout>
