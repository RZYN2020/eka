---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTagCounts, sortWriting, tagSlug } from '../../lib/content';

const writing = sortWriting((await getCollection('writing')).filter((entry) => !entry.data.draft));
const notes = (await getCollection('notes')).filter((entry) => !entry.data.draft);
const tags = getTagCounts([...writing, ...notes]);
---

<BaseLayout title="Tags">
	<header class="page-heading">
		<h1>Tags</h1>
	</header>

	<ul class="tag-index">
		{tags.map(([tag, count]) => (
			<li>
				<a href={`/tags/${tagSlug(tag)}/`}>{tag}</a>
				<span>{String(count).padStart(2, '0')}</span>
			</li>
		))}
	</ul>
</BaseLayout>
