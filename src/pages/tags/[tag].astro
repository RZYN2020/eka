---
import { getCollection } from 'astro:content';
import WritingList from '../../components/WritingList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTagCounts, sortWriting, tagSlug } from '../../lib/content';

export async function getStaticPaths() {
	const entries = sortWriting((await getCollection('writing')).filter((entry) => !entry.data.draft));
	return getTagCounts(entries).map(([tag]) => ({
		params: { tag: tagSlug(tag) },
		props: { tag, entries: entries.filter((entry) => entry.data.tags.includes(tag)) },
	}));
}

const { tag, entries } = Astro.props;
---

<BaseLayout title={tag}>
	<header class="page-heading">
		<p class="eyebrow">Tag</p>
		<h1>{tag}</h1>
	</header>
	<WritingList entries={entries} />
</BaseLayout>
