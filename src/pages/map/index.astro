---
import '../../styles/global.css';
import 'leaflet/dist/leaflet.css';
import '../../styles/map.css';
import '../../styles/map-theme.css';
import ThemeToggle from '../../components/ThemeToggle.astro';
---
<!doctype html>
<html lang="zh-CN" data-theme="light">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<meta name="theme-color" content="#ffffff" />
	<script is:inline>
		const savedTheme = localStorage.getItem('eka-theme');
		const themes = ['light', 'sepia', 'dark', 'graphite'];
		const theme = themes.includes(savedTheme)
			? savedTheme
			: matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		const themeColors = { light: '#fbfbfa', sepia: '#f7f3e9', dark: '#1e1e1e', graphite: '#17191c' };
		document.documentElement.dataset.theme = theme;
		document.querySelector('meta[name="theme-color"]')?.setAttribute('content', themeColors[theme]);
	</script>
	<link rel="icon" type="image/webp" href="/favicon.webp" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600&display=swap" />
	<title>旅行足迹 · Eka</title>
</head>
<body>
<div class="flex flex-col h-screen">
    <!-- Header -->
    <div class="topbar">
        <button id="btnBack" class="btn-back" aria-label="返回" title="返回首页">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
        </button>
        <h1>旅行足迹</h1>
        <ThemeToggle />
    </div>

    <!-- Body: edge-to-edge flex row -->
    <div class="flex flex-1 min-h-0">
        <!-- Map -->
        <div class="flex-1 relative min-h-0">
            <div class="map-shell">
                <div id="map"></div>
            </div>
            <!-- Map controls: view scope + highlight granularity -->
            <div class="map-ctrls-bar">
                <div class="map-ctrls">
                    <button class="map-ctrl-btn active" data-view="china" aria-pressed="true">中国</button>
                    <button class="map-ctrl-btn" data-view="world" aria-pressed="false">世界</button>
                </div>
                <div class="map-ctrls" id="modeControls">
                    <button class="map-ctrl-btn active" data-mode="city" aria-pressed="true">城市</button>
                    <button class="map-ctrl-btn" data-mode="province" aria-pressed="false">省份</button>
                </div>
                <button class="journey-button" id="btnJourney" aria-pressed="false" disabled>人生轨迹</button>
            </div>
            <div class="journey-status" id="journeyStatus" aria-live="polite" hidden>
                <div class="journey-status-head">
                    <span id="journeyPeriod"></span>
                    <span id="journeyProgress"></span>
                </div>
                <strong id="journeyCity"></strong>
                <span id="journeySummary"></span>
                <div class="journey-actions">
                    <button type="button" id="btnJourneyPlay" aria-pressed="true">暂停</button>
                    <button type="button" id="btnJourneyNext">下一步</button>
                </div>
            </div>
            <!-- Back to overview -->
            <div class="btn-global-wrap" id="backWrap">
                <button class="btn-global" id="btnGlobal">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
                    返回全局视图
                </button>
            </div>
            <div id="loaderCover" class="loader-cover"><div class="loader-ring"></div></div>
            <button id="btnMob" class="btn-mob" aria-label="列表" aria-expanded="false" title="列表">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/></svg>
            </button>
        </div>

        <!-- Sidebar -->
        <div id="sidebarCol" class="sidebar-col min-h-0 flex-shrink-0" style="width:var(--sidebar-w)">
            <div class="sidebar">
                <div class="sidebar-top">
                    <h2>时间线</h2>
                    <div class="sub" id="statsSummary"></div>
                </div>
                <div class="sidebar-scroll">
                    <div class="tl" id="timeline"><p style="color:var(--muted);font-size:0.84rem;text-align:center;padding:2rem 0;">加载中…</p></div>
                    <button class="back-top-btn" id="btnBackTop" title="回到顶部">↑ 回到顶部</button>
                </div>
                <div class="sidebar-foot" id="statsBar">
                    <div class="stats-row"></div>
                    <div class="prov-bar-wrap"><div class="prov-bar-fill" id="provBar" style="width:0%"></div></div>
                    <div class="legend" id="legend"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="../../scripts/travel-map.js"></script>
</body>
</html>
