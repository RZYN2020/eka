---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { writingRedirects } from '../../config/redirects';
import { sortWriting, writingSlug } from '../../lib/content';

export async function getStaticPaths() {
	const entries = sortWriting((await getCollection('writing')).filter((entry) => !entry.data.draft));
	return [
		...entries.map((entry, index) => ({
			params: { slug: writingSlug(entry.id) },
			props: {
				entry,
				newer: entries[index - 1],
				older: entries[index + 1],
			},
		})),
		...Object.entries(writingRedirects).map(([slug, destination]) => ({
			params: { slug },
			props: { destination },
		})),
	];
}

const { entry, destination, newer, older } = Astro.props;
if (destination) return Astro.redirect(destination, 301);
const { Content, headings } = await render(entry);
---

<ArticleLayout entry={entry} headings={headings} newer={newer} older={older}>
	<Content />
</ArticleLayout>
