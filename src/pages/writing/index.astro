---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, sortWriting, writingSlug } from '../../lib/content';

const entries = sortWriting((await getCollection('writing')).filter((entry) => !entry.data.draft));
---

<BaseLayout title="Writing">
	<header class="page-heading">
		<h1>Writing</h1>
	</header>

	<div class="content-list">
		{entries.map((entry) => (
			<a class="content-row" href={`/writing/${writingSlug(entry.id)}/`}>
				<time class="content-index" datetime={entry.data.publishedAt.toISOString()}>{formatDate(entry.data.publishedAt, 'sv-SE')}</time>
				<div class="content-main"><h2>{entry.data.title}</h2></div>
			</a>
		))}
	</div>
</BaseLayout>
