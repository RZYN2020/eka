---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, plainExcerpt, sortWriting, writingKindLabel, writingSlug } from '../../lib/content';

const entries = sortWriting((await getCollection('writing')).filter((entry) => !entry.data.draft));
---

<BaseLayout title="Writing" description="技术、社会与个人经验：经过整理的完整写作。">
	<header class="page-heading">
		<div class="eyebrow">Essays · Technical · Journal</div>
		<h1>Writing</h1>
		<p>完整的论述，私人的经验，以及那些值得被认真写下来的时刻。</p>
	</header>

	<div class="filter-bar" aria-label="文章筛选">
		<button class="filter-button" type="button" data-filter="all" aria-pressed="true">全部</button>
		<button class="filter-button" type="button" data-filter="essay" aria-pressed="false">思想</button>
		<button class="filter-button" type="button" data-filter="technical" aria-pressed="false">技术</button>
		<button class="filter-button" type="button" data-filter="journal" aria-pressed="false">手记</button>
	</div>

	<div class="content-list" id="writing-list">
		{entries.map((entry, index) => (
			<a class="content-row" data-kind={entry.data.kind} href={`/writing/${writingSlug(entry.id)}/`}>
				<span class="content-index">{String(index + 1).padStart(2, '0')}</span>
				<div class="content-main">
					<h2>{entry.data.title}</h2>
					<p>{plainExcerpt(entry.body ?? '', entry.data.description)}</p>
				</div>
				<div class="content-meta">
					<div class="tagline">{writingKindLabel[entry.data.kind]}</div>
					<div>{formatDate(entry.data.publishedAt)}</div>
				</div>
			</a>
		))}
	</div>
</BaseLayout>

<script>
	const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
	const rows = [...document.querySelectorAll<HTMLElement>('[data-kind]')];
	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			const filter = button.dataset.filter;
			buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
			rows.forEach((row) => {
				row.hidden = filter !== 'all' && row.dataset.kind !== filter;
			});
		});
	});
</script>
