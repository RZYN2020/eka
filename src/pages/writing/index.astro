---
import { getCollection } from 'astro:content';
import WritingList from '../../components/WritingList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortWriting } from '../../lib/content';

const entries = sortWriting((await getCollection('writing')).filter((entry) => !entry.data.draft));
---

<BaseLayout title="Writing">
	<header class="page-heading">
		<h1>Writing</h1>
	</header>

	<WritingList entries={entries} />
</BaseLayout>
