---
import { getCollection } from 'astro:content';
import { writingSlug } from '../../lib/content';

export async function getStaticPaths() {
	const entries = (await getCollection('writing')).filter((entry) => !entry.data.draft);
	return entries.flatMap((entry) =>
		entry.data.legacyUrls
			.filter((url) => url.startsWith('/notes/'))
			.map((url) => ({
				params: { slug: url.replace(/^\/notes\/|\/$/g, '') },
				props: { destination: `/writing/${writingSlug(entry.id)}/` },
			})),
	);
}

return Astro.redirect(Astro.props.destination, 301);
---
