---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { noteSlug, plainExcerpt, sortNotes } from '../../lib/content';

const entries = sortNotes((await getCollection('notes')).filter((entry) => !entry.data.draft));
const groups = Map.groupBy(entries, (entry) => entry.data.topic);
---

<BaseLayout title="Notes" description="算法、系统、编程语言与人工智能的长期学习笔记。">
	<header class="page-heading">
		<h1>Notes</h1>
		<p>算法、系统、编程语言与人工智能的学习笔记。</p>
	</header>

	<div class="note-groups">
		{[...groups.entries()].map(([topic, topicEntries]) => (
			<section>
				<div class="section-rule">
					<h2>{topic}</h2>
					<span>{String(topicEntries.length).padStart(2, '0')}</span>
				</div>
				<div class="content-list">
					{topicEntries.map((entry) => (
						<a class="content-row" href={`/notes/${noteSlug(entry.id)}/`}>
							<span class="content-index">{entry.data.source === 'algorithm' ? 'Algorithm' : 'Note'}</span>
							<div class="content-main">
								<h3>{entry.data.title}</h3>
								<p>{plainExcerpt(entry.body ?? '', entry.data.description, 105)}</p>
							</div>
						</a>
					))}
				</div>
			</section>
		))}
	</div>
</BaseLayout>

<style>
	.note-groups {
		display: grid;
		gap: 4.5rem;
	}

	.section-rule span {
		color: var(--faint);
		font-family: var(--font-mono);
		font-size: 0.65rem;
	}

	.note-groups .content-list {
		padding-top: 0.2rem;
	}
</style>
