---
import { getCollection } from 'astro:content';
import NoteList from '../../components/NoteList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortNotes } from '../../lib/content';

const entries = sortNotes((await getCollection('notes')).filter((entry) => !entry.data.draft));
const groups = Map.groupBy(entries, (entry) => entry.data.topic);
---

<BaseLayout title="Notes">
	<header class="page-heading">
		<h1>Notes</h1>
	</header>

	<div class="note-groups">
		{[...groups.entries()].map(([topic, topicEntries]) => (
			<section>
				<div class="section-rule">
					<h2>{topic}</h2>
					<span>{String(topicEntries.length).padStart(2, '0')}</span>
				</div>
				<NoteList entries={topicEntries} />
			</section>
		))}
	</div>
</BaseLayout>
