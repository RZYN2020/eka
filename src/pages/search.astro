---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, sortWriting, writingDescription, writingSlug } from '../lib/content';

const writing = sortWriting((await getCollection('writing')).filter((entry) => !entry.data.draft));
const documents = writing.map((entry) => ({
	title: entry.data.title,
	meta: [entry.data.category, ...entry.data.subcategories, ...entry.data.tags].join(' '),
	description: writingDescription(entry, 110),
	category: entry.data.category,
	date: formatDate(entry.data.publishedAt, 'sv-SE'),
	url: `/writing/${writingSlug(entry.id)}/`,
}));
---

<BaseLayout title="Search">
	<header class="page-heading">
		<h1>Search</h1>
	</header>

	<label class="search-box">
		<span>Search</span>
		<input id="search-input" type="search" placeholder="输入关键词…" autocomplete="off" aria-describedby="search-count" />
	</label>
	<p class="search-count" id="search-count">共 {documents.length} 条内容</p>
	<div class="content-list search-results" id="search-results"></div>

	<script
		is:inline
		type="application/json"
		id="search-data"
		set:html={JSON.stringify(documents).replace(/</g, '\\u003c')}
	/>
</BaseLayout>

<script>
	interface SearchDocument {
		title: string;
		meta: string;
		description: string;
		category: string;
		date: string;
		url: string;
	}

	const rawData: unknown = JSON.parse(document.querySelector('#search-data')?.textContent ?? '[]');
	const data: SearchDocument[] = Array.isArray(rawData)
		? rawData.filter((item): item is SearchDocument => (
			typeof item === 'object'
			&& item !== null
			&& typeof item.title === 'string'
			&& typeof item.meta === 'string'
			&& typeof item.description === 'string'
			&& typeof item.category === 'string'
			&& typeof item.date === 'string'
			&& typeof item.url === 'string'
		))
		: [];
	const input = document.querySelector<HTMLInputElement>('#search-input');
	const results = document.querySelector<HTMLElement>('#search-results');
	const count = document.querySelector<HTMLElement>('#search-count');

	function resultRow(item: SearchDocument, index: number) {
		const link = document.createElement('a');
		link.className = 'content-row';
		link.href = item.url;

		const itemIndex = document.createElement('span');
		itemIndex.className = 'content-index';
		itemIndex.textContent = String(index + 1).padStart(2, '0');

		const main = document.createElement('div');
		main.className = 'content-main';
		const heading = document.createElement('h2');
		heading.textContent = item.title;
		const description = document.createElement('p');
		description.textContent = item.description;
		main.append(heading, description);

		const meta = document.createElement('div');
		meta.className = 'content-meta';
		meta.textContent = [item.date, item.category].filter(Boolean).join(' · ');
		link.append(itemIndex, main, meta);
		return link;
	}

	function render(query = '') {
		const term = query.trim().toLocaleLowerCase();
		const matches = term
			? data.filter((item) => `${item.title} ${item.meta} ${item.description}`.toLocaleLowerCase().includes(term))
			: data.slice(0, 12);
		if (count) count.textContent = term ? `找到 ${matches.length} 条内容` : `最近展示 ${matches.length} / ${data.length} 条内容`;
		if (!results) return;
		if (matches.length === 0) {
			const empty = document.createElement('p');
			empty.className = 'search-empty';
			empty.textContent = '没有匹配的内容，试试更短或不同的关键词。';
			results.replaceChildren(empty);
			return;
		}
		results.replaceChildren(...matches.map(resultRow));
	}

	input?.addEventListener('input', () => render(input.value));
	render();
</script>

<style>
	.search-box {
		display: block;
		width: min(100%, var(--layout-search));
		margin-bottom: 16px;
	}

	.search-box span {
		display: none;
	}

	.search-box input {
		width: 100%;
		padding: 8px 0;
		border: 0;
		border-bottom: 1px solid var(--line);
		outline: none;
		background: transparent;
		color: var(--ink);
		font: inherit;
		font-size: 16px;
	}

	.search-box input::placeholder {
		color: var(--faint);
	}

	.search-box input:focus-visible {
		border-bottom-color: var(--link);
	}

	.search-count {
		margin: 0 0 32px;
		color: var(--muted);
		font-size: 14px;
	}

	.search-results {
		gap: 0;
		width: min(100%, var(--layout-wide));
		border-top: 1px solid var(--line);
	}

	.search-results :global(.content-row) {
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 24px;
		padding: 14px 0;
		border-bottom: 1px solid var(--line);
	}

	.search-results :global(.content-index) {
		display: none;
	}

	.search-results :global(.content-main p) {
		display: -webkit-box;
		overflow: hidden;
		margin: 4px 0 0;
		color: var(--muted);
		font-size: 13px;
		line-height: 1.55;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.search-results :global(.content-meta) {
		display: block;
		color: var(--faint);
		font-size: 11px;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.search-results :global(.search-empty) {
		margin: 0;
		padding: 24px 0;
		border-bottom: 1px solid var(--line);
		color: var(--muted);
		font-size: 14px;
	}

	@media (max-width: 700px) {
		.search-results :global(.content-row) {
			grid-template-columns: 1fr;
			gap: 5px;
		}
	}
</style>
