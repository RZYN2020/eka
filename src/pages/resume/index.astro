---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResumeDocument from '../../components/ResumeDocument.astro';

const entry = await getEntry('resume', 'zh');
if (!entry) throw new Error('未找到中文简历内容');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title}>
	<header class="article-header resume-header">
		<p class="eyebrow">Résumé</p>
		<h1>{entry.data.title}</h1>
		<div class="resume-toolbar">
			<a class="text-link" href="/resume/resume.pdf" download>下载 PDF ↓</a>
			<a class="text-link" href="/resume/print/" target="_blank" rel="noopener">打印视图 ↗</a>
		</div>
	</header>
	<div class="article-shell resume-shell">
		<ResumeDocument {Content} />
	</div>
</BaseLayout>

<style>
	.resume-header,
	.resume-shell {
		width: min(100%, 720px);
	}

	.resume-header {
		margin-bottom: 42px;
	}

	.resume-header .eyebrow {
		margin: 0 0 8px;
	}
</style>
