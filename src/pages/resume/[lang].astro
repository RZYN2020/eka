---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const entries = await getCollection('resume');
	return entries.map((entry) => ({
		params: { lang: entry.data.lang },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const labels = { zh: '中文', en: 'English', ja: '日本語' };
---

<BaseLayout title={entry.data.title}>
	<header class="article-header">
		<h1>{entry.data.title}</h1>
		<div class="resume-toolbar">
			{Object.entries(labels).map(([lang, label]) => (
				<a class="text-link" href={`/resume/${lang}/`}>{label}</a>
			))}
			<a class="text-link" href={`/resume/resume_${entry.data.lang}.pdf`} download>下载 PDF ↓</a>
		</div>
	</header>
	<div class="article-shell">
		<div class="prose prose-eka resume-prose">
			<Content />
		</div>
	</div>
</BaseLayout>

<style>
	.resume-prose :global(h2) {
		font-size: 1.35rem;
	}

	.resume-prose :global(p),
	.resume-prose :global(li) {
		font-family: var(--font-sans);
		font-size: 0.9rem;
		line-height: 1.75;
	}
</style>
